---
import { getBlogUrl } from '../lib/env.ts'
import type { NavItem } from '../types'
import SearchForm from './SearchForm.astro'

interface Props {
  currentPathname?: string
  googleSearchSite?: string
  navs?: NavItem[]
  siteUrl?: string
}

const { currentPathname = Astro.url.pathname, googleSearchSite, navs = [], siteUrl = '' } = Astro.props

const blogUrl = getBlogUrl()
const primaryNavItems = [
  { href: `${siteUrl}/`, pathname: `${siteUrl}/`, title: 'Home' },
  { href: `${siteUrl}/tags`, pathname: `${siteUrl}/tags`, title: 'Tags' },
  { href: `${siteUrl}/links`, pathname: `${siteUrl}/links`, title: 'Links' },
  ...(blogUrl ? [{ href: blogUrl, pathname: blogUrl, title: 'Blog', external: true }] : []),
]
---

<nav class="site-navigation" aria-label="Primary navigation">
  <ul>
    {
      primaryNavItems.map((nav) => (
        <li>
          <a
            href={nav.href}
            title={nav.title}
            aria-current={currentPathname === nav.pathname ? 'page' : undefined}
            target={'external' in nav ? '_blank' : undefined}
            rel={'external' in nav ? 'noopener noreferrer' : undefined}
          >
            {nav.title}
          </a>
        </li>
      ))
    }
    {
      navs.map((nav) => (
        <li>
          <a href={nav.href} title={nav.title} target="_blank" rel="noopener noreferrer">
            {nav.title}
          </a>
        </li>
      ))
    }
  </ul>
  <SearchForm action="/search/result" googleSearchSite={googleSearchSite} />
</nav>
