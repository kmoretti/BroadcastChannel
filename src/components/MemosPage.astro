---
import type { Memo } from '../types.ts'
import MemoEntry from './MemoEntry.astro'

interface Props {
  memos: Memo[]
  nextPageToken?: string
  title?: string
}

const { memos, nextPageToken, title } = Astro.props
---

<div class="memos-page">
  {title && <h1 class="mb-6 text-2xl font-bold text-[var(--text)]">{title}</h1>}
  <div class="memos-list space-y-8">
    {
      memos.map((memo) => (
        <div class="memo-list-item">
          <MemoEntry memo={memo} />
          <a href={`/posts/${memo.shortId}`} class="mt-2 inline-block text-sm text-[var(--link)] hover:underline">
            查看详情 →
          </a>
        </div>
      ))
    }
  </div>

  <nav class="memo-pagination mt-10 flex justify-between">
    {
      nextPageToken ? (
        <a
          href={`/before/${nextPageToken}`}
          class="rounded-lg bg-[var(--bg-soft)] px-4 py-2 text-[var(--text)] hover:bg-[var(--bg-mute)]"
        >
          下一页 →
        </a>
      ) : (
        <span class="text-[var(--text-muted)]">已经到底了</span>
      )
    }
  </nav>
</div>
