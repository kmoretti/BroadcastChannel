---
import { Icon } from 'astro-icon/components'
---

<a
  href="#main-content"
  id="back-to-top"
  aria-label="Back to top"
  class="fixed bottom-4 right-4 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--bg)] text-[var(--text)] shadow-lg border border-[var(--border)] transition-transform duration-200 ease-out hover:-translate-y-1 md:bottom-6 md:right-6"
>
  <Icon name="ri:arrow-up-line" class="h-6 w-6" />
</a>
