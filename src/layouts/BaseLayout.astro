---
import '../styles/app.css'
import { SEO } from 'astro-seo'
import BackToTop from '../components/BackToTop.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { getEnv } from '../lib/env'
import type { SiteInfo } from '../lib/memos/instance.ts'
import type { SeoMeta } from '../types'

const { SITE_URL, RSS_URL, RSS_PREFIX } = Astro.locals

interface Props {
  title: string
  description?: string
  site?: SiteInfo
  pageClass?: string
  pageType?: 'home' | 'post' | 'page'
  seo?: SeoMeta
}

const { title, description, site, pageClass, pageType = 'page', seo } = Astro.props

const locale = getEnv(import.meta.env, 'LOCALE')
const twitter = getEnv(import.meta.env, 'TWITTER')
const hasCustomTitle = Boolean(seo?.title)

const seoParams = {
  title: seo?.title || title,
  description: seo?.text || description,
  noindex: Boolean(seo?.noindex),
  nofollow: Boolean(seo?.nofollow),
  openGraph: {
    basic: {
      title: seo?.title || title,
      type: pageType === 'post' ? 'article' : 'website',
      image: site?.avatar || '',
      url: Astro.url.toString(),
    },
    optional: {
      description: seo?.text || description,
    },
  },
}

const HEADER_INJECT = getEnv(import.meta.env, 'HEADER_INJECT')
const FOOTER_INJECT = getEnv(import.meta.env, 'FOOTER_INJECT')

const skipLinkText = 'Skip to main content'
---

<!doctype html>
<html lang={locale ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={`${RSS_PREFIX}${title}`} href={RSS_URL} />
    <SEO
      titleTemplate={hasCustomTitle ? `%s | ${title}` : undefined}
      titleDefault={title}
      twitter={{
        card: 'summary_large_image',
        creator: twitter ? `@${twitter}` : undefined,
      }}
      {...seoParams}
    />
    <script is:inline>
      ;(function () {
        const stored = localStorage.getItem('theme')
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        if (stored ? stored === 'dark' : systemDark) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
    <Fragment set:html={HEADER_INJECT} />
  </head>

  <body class:list={[pageType, pageClass]}>
    <a href="#main-content" class="skip-link">{skipLinkText}</a>
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <BackToTop />
    <ThemeToggle />
    <Fragment set:html={FOOTER_INJECT} />
  </body>
</html>
