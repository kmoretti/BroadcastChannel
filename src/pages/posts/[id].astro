---
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteNavigation from '../../components/SiteNavigation.astro'
import MemoEntry from '../../components/MemoEntry.astro'
import CreatorAvatar from '../../components/CreatorAvatar.astro'
import { getMemoById, getMemoPublicUrl } from '../../lib/memos/index.ts'
import { getSiteInfo } from '../../lib/memos/instance.ts'
import { renderMarkdown } from '../../lib/memos/markdown.ts'
import { formatRelativeTime } from '../../lib/post-ui.ts'
import type { Memo, MemoComment } from '../../types.ts'

const { id } = Astro.params
if (!id) {
  return Astro.redirect('/', 302)
}

let memo: Memo
let comments: MemoComment[]

try {
  const result = await getMemoById(`memos/${id}`)
  memo = result.memo
  comments = result.comments
} catch (error: unknown) {
  const statusCode = error && typeof error === 'object' && 'statusCode' in error ? Number(error.statusCode) : undefined
  if (statusCode === 404) {
    return new Response('Not Found', { status: 404 })
  }
  throw error
}

const site = await getSiteInfo()
const publicUrl = getMemoPublicUrl(site.instanceUrl, memo.shortId)
---

<BaseLayout
  title={`${memo.snippet.slice(0, 40)} - ${site.title}`}
  description={memo.snippet}
  site={site}
  pageType="post"
>
  <SiteHeader site={site} />
  <SiteNavigation />
  <div class="mx-auto max-w-[680px] px-4 py-8">
    <MemoEntry memo={memo} instanceUrl={site.instanceUrl} />

    <section class="memo-comments mt-10">
      <h2 class="mb-4 text-lg font-bold text-[var(--text)]">评论</h2>
      {
        comments.length === 0 ? (
          <p class="text-[var(--text-muted)]">暂无评论</p>
        ) : (
          <div class="space-y-4">
            {comments.map((comment) => (
              <div class="comment-item flex gap-3 rounded-lg bg-[var(--bg-soft)] p-4">
                <CreatorAvatar creator={comment.creator} />
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-[var(--text)]">
                      {comment.creator.displayName || comment.creator.username}
                    </span>
                    <time class="text-xs text-[var(--text-muted)]" datetime={comment.createTime}>
                      {formatRelativeTime(comment.createTime)}
                    </time>
                  </div>
                  <div
                    class="comment-content mt-1 text-sm text-[var(--text)]"
                    set:html={renderMarkdown(comment.content)}
                  />
                </div>
              </div>
            ))}
          </div>
        )
      }
      <a
        href={publicUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block text-sm text-[var(--link)] hover:underline"
      >
        前往 Memos 原文评论 / 点赞 →
      </a>
    </section>
  </div>
</BaseLayout>
